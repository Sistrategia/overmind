<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <ProjectReference Include="../../src/Framework/Sistrategia.Data.SqlClient/Sistrategia.Data.SqlClient.csproj" />
    <ProjectReference Include="../../src/Data/Sistrategia.Overmind.Data.SqlClient/Sistrategia.Overmind.Data.SqlClient.csproj" />
    <Content Include="../../src/Framework/Sistrategia.Data.SqlClient/Scripts/**/*.sql" Link="ProductionSql/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../sql/*.sql" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
