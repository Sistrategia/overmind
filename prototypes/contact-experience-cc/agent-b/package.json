{
  "name": "overmind-contact-experience-agent-b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent B prototypes: Casefile, Studio and Thread — collaborative investigation lens",
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5178 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "evidence": "playwright test --grep @evidence"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
