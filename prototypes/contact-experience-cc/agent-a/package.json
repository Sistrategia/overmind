{
  "name": "overmind-contact-experience-agent-a",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent A prototypes (operational clarity lens): three runnable UI variants for Overmind contact management and audit.",
  "scripts": {
    "dev": "vite --port 5181 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5181 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run build && npm run test && npm run e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
